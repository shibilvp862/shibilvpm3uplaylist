
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Plyr Player</title>
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>
  <style>
    body {
      background-color: #000;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      color: #fff;
    }
    video {
      width: 90%;
      max-width: 900px;
      border-radius: 10px;
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.1);
    }
    .ad-container {
      margin: 15px 0;
      display: flex;
      justify-content: center;
    }
  </style>
</head>
<body>

  <!-- Top Ad -->
  <div class="ad-container">
    <ins style="width: 300px;height:250px" data-width="300" data-height="250" class="lb29351f7dd" data-domain="//data527.click" data-affquery="/bcffca7950d0d34b5fdd/b29351f7dd/?placementName=default">
      <script src="//data527.click/js/responsive.js" async></script>
    </ins>
  </div>

  <!-- Video Player -->
  <video id="player" controls playsinline></video>

  <!-- Bottom Ad -->
  <div class="ad-container">
    <ins style="width: 300px;height:250px" data-width="300" data-height="250" class="lb29351f7dd" data-domain="//data527.click" data-affquery="/bcffca7950d0d34b5fdd/b29351f7dd/?placementName=default">
      <script src="//data527.click/js/responsive.js" async></script>
    </ins>
  </div>

  <!-- SuperCounters and Extra Ad -->
  <center>
    <script type="text/javascript" src="//widget.supercounters.com/ssl/online_i.js"></script>
    <script type="text/javascript">sc_online_i(1724044,"ffffff","e61c1c");</script>

    <script type="text/javascript" src="//widget.supercounters.com/ssl/hit.js"></script>
    <script type="text/javascript">sc_hit(1724045,0,5);</script><br>
    <noscript><a href="http://www.supercounters.com/">free online counter</a></noscript>
  </center>

  
  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const videoSrc = urlParams.get('dtv');

    if (videoSrc) {
      const video = document.getElementById('player');

      if (Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(videoSrc);
        hls.attachMedia(video);
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = videoSrc;
      }

      new Plyr(video, {
        controls: [
          'play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'settings', 'fullscreen'
        ],
        settings: ['quality', 'speed'],
      });
    } else {
      document.body.innerHTML = '<h2 style="color:white;text-align:center;margin-top:50px;">Please open this page with ?dtv=YOUR_M3U8_URL</h2>';
    }
  </script>

</body>
</html>


